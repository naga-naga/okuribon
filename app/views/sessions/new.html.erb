<% content_for :title, 'ログイン' %>

<%# この画面だけ共通ヘッダーを持たない。すぐ下の見出しがサービス名なので、
    ヘッダーにも出すと同じ名が上下に並ぶ %>
<% hide_header! %>

<div class="flex min-h-dvh items-center justify-center px-4 py-10">
  <div class="flex w-full max-w-[480px] flex-col gap-8 p-6 sm:p-10">
    <div class="flex flex-col gap-2.5">
      <div class="h-[22px] w-[22px] rounded-[2px] bg-accent" aria-hidden="true"></div>
      <h1 class="text-[26px] font-bold leading-[1.45] text-ink"><%= t('service.name') %></h1>
      <p class="text-[13.5px] leading-[1.9] text-ink-muted">
        顔見知りで集まって、電子書籍を持ちよって交換するためのツールです。招待された交換会にだけ参加できます。
      </p>
    </div>

    <%# 未ログインの人だけがここへ来る。ログイン済みは交換会一覧へ送られる %>
    <% if @pending_participation.present? %>
      <p class="rounded-[5px] border border-line bg-paper px-5 py-4 text-[13.5px] leading-[1.9] text-ink">
        <%= t('participation.login_required', name: @pending_participation.name) %>
      </p>
    <% end %>

    <%# デザインには Google / GitHub / Discord が並ぶが、対応プロバイダは Google だけにする %>
    <%# 認証開始は POST に限る。GET で踏めると、外部サイトに置いた
        画像やリンクだけで認証をやり直させられる %>
    <%= button_to 'Google でログイン', '/auth/google_oauth2', method: :post,
                  form_class: 'w-full',
                  class: 'w-full cursor-pointer rounded-[5px] border border-line-strong bg-paper ' \
                         'px-5 py-3.5 text-left text-[14.5px] font-medium text-ink hover:bg-paper-hover' %>

    <p class="border-t border-line pt-5 text-[12px] leading-[1.85] text-ink-subtle">
      受け取るのは表示名とアイコンだけです。メールアドレスは保存しません。
    </p>

    <%# 開発用の裏口ログイン。ログイン済みで利用者を
        入れ替えるときは、共通ヘッダーのログアウトを通ってこの画面へ来る。
        条件は config/routes.rb と揃えること。片方だけ変えると、
        押せば404になるリンクが残る %>
    <% if Rails.env.local? %>
      <div class="border-t border-line pt-5">
        <%= link_to '開発用ログイン（OAuth を通さず利用者を入れ替える）', dev_login_path,
                    class: 'text-[12px] leading-[1.85] text-ink-subtle underline underline-offset-2 hover:text-ink' %>
      </div>
    <% end %>
  </div>
</div>
