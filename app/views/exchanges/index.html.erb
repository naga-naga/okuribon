<% content_for :title, '交換会一覧' %>

<%# カードが左右2列に分かれるので、他の画面より広く取る。
    640px のままだと締切の欄に「あと6日」が収まらず、行ごと折り返る %>
<div class="mx-auto w-full max-w-[900px] px-4 py-10 sm:px-6">
  <% if @cards.empty? %>
    <%# 白紙で返すと、壊れているのか参加していないのか区別がつかない。
        見出しから状態を言い切る。並ぶものが無いので、並び順の一文も置かない。
        カードが無いぶん幅を狭める。900px のまま読ませると1行が長すぎる %>
    <div class="max-w-[560px]">
      <h1 class="text-[26px] font-bold leading-[1.45] text-ink">まだどこにも参加していません</h1>
      <p class="mt-2 text-[13.5px] leading-[1.9] text-ink-muted">
        交換会は招待URLから参加します。誘われたURLを開くか、自分で交換会をつくって仲間に配ってください。
      </p>

      <%# つくる側は、何人でどれくらいの期間かの見当が付かないと日時を決められない。
          数字は少人数向けという想定から採る %>
      <div class="mt-6 rounded-[5px] border border-dashed border-line-strong px-5 py-4">
        <p class="text-[13px] font-bold text-ink">主催するときの目安</p>
        <p class="mt-1.5 text-[12.5px] leading-[1.8] text-ink-muted">
          3人から十数人くらい。登録に2週間、希望提出に1週間ほど取ると、みんなが忘れずに参加できます。
        </p>
      </div>

      <%# 主催をはじめる道はこの画面にしかない。並ぶものが有るときは輪郭に落とすが、
          こちらは塗りのまま。競る相手のカードが1枚も無く、本文が真っ白なこの画面では、
          押してよいものだと分かる大きさが要る %>
      <%= link_to '交換会をつくる', new_exchange_path,
                  class: 'mt-6 inline-block rounded-[5px] bg-accent px-6 py-3 text-[14px] ' \
                         'font-medium text-paper no-underline hover:bg-accent-hover' %>
    </div>
  <% else %>
    <%# つくる口は見出しの右に置く。カードの並びに混ぜると、交換会でないものが
        1枚だけ紛れる。塗りにしないのは、締切が24時間を切ったカードの朱の面と
        競るため。ざっと見て目に飛び込む朱の面は1枚だけにしておく（6.6） %>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <h1 class="text-[26px] font-bold leading-[1.45] text-ink">あなたの交換会</h1>

        <%# 並びが日時の1本の軸であることは、カードを見ても分からない。
            動いている件数のほうは出さない。朱になるカードの枚数と一致するので、
            十数件しか並ばないこの画面では、目で数えられるものを文字でも数えることになる %>
        <p class="mt-1.5 text-[13px] text-ink-muted">締切の近いものから並びます。</p>
      </div>

      <%# 狭い画面では的を44pxにする。指で押す口の大きさはガイドが全画面で
          決めているので、この画面だけ小さいままにしない %>
      <%= link_to '交換会をつくる', new_exchange_path,
                  class: 'flex-none rounded-[5px] border border-accent bg-paper px-5 py-3 ' \
                         'text-[13px] font-medium text-accent no-underline ' \
                         'hover:bg-paper-hover sm:py-2.5' %>
    </div>

    <ul class="mt-6 flex flex-col gap-3">
      <% @cards.each do |card| %>
        <% exchange = card.exchange %>
        <% tone = exchange_card_tone(exchange, at: requested_at) %>
        <%# 締切の欄は、狭い画面ではカードの下に回り込む %>
        <li class="flex flex-col overflow-hidden rounded-[5px] border sm:flex-row
                   <%= exchange_card_style(tone, :card) %>">
          <div class="flex-1 px-5 py-5">
            <%# フェーズと素性を1行にまとめ、交換会名の上に置く。狭い画面では折り返る %>
            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-2">
              <span class="rounded-[3px] px-2 py-1 text-[12px] font-medium
                           <%= exchange_card_style(tone, :badge) %>">
                <%= exchange.phase_name(at: requested_at) %>
              </span>

              <%# いくつも参加していると、名前だけではどれがどの会だったか思い出せない。
                  誰が仕切っていて何人いるのかが、いちばん短い手がかりになる %>
              <span class="text-[12px] text-ink-subtle">
                主催 <%= exchange_owner_name(exchange, current_user) %>
                ／ <span class="tabular"><%= card.participants_count %>人</span>
              </span>
            </div>

            <%# 押しどころは交換会名だけにする。カード全体をリンクにすると、
                中に置いたフェーズや日時まで押せるように見えてしまう。
                朱と下線はリンクの既定のまま。朱は押すものの担当でもある %>
            <h2 class="mt-2.5 text-[17px] font-bold leading-[1.5]">
              <%= link_to exchange.name, exchange_path(exchange) %>
            </h2>

            <%# フェーズと締切だけでは、この会で自分が何をすればよいかまでは分からない。
                交換会トップの「あなたがすること」と同じ置き場所から引く。
                2か所で別々に組むと、片方だけが古い言い方で残る %>
            <p class="mt-2 text-[13px] leading-[1.7] text-ink"><%= card.headline %></p>
          </div>

          <%# 締切の欄。待つ日時が無いフェーズでも欄ごと消さない。
              空けてしまうと、締切を見落としたのか、そもそも無いのかが読み取れない %>
          <div class="flex flex-none flex-col justify-center gap-1 px-5 py-4 sm:w-[220px] sm:py-5
                      <%= exchange_card_style(tone, :aside) %>">
            <% if exchange.published?(at: requested_at) %>
              <%# 結果公開はもう終わっている。締切の代わりに、その日の行き先を置く。
                  日時は他の画面と同じ書式で出す。ここだけ短い書式を持つと、
                  同じ日時が画面をまたいで別の顔で出る %>
              <span class="tabular text-[11.5px] <%= exchange_card_style(tone, :note) %>">
                <%= l exchange.matched_at, format: :schedule %> 公開
              </span>
              <%= link_to '結果を見る', exchange_result_path(exchange),
                          class: 'mt-1 rounded-[5px] bg-success px-4 py-2.5 text-center ' \
                                 'text-[13.5px] font-medium text-paper no-underline hover:bg-success-hover' %>
            <% elsif (deadline = exchange.next_deadline(at: requested_at)) %>
              <span class="text-[11px] <%= exchange_card_style(tone, :label) %>">
                <%= exchange.next_deadline_name(at: requested_at) %>まで
              </span>
              <%# 日付だけでは、それが今日中なのか来週なのかを毎回読み解くことになる。
                  日時のほうは補足へ下げる %>
              <span class="tabular text-[22px] font-bold leading-[1.25]
                           <%= exchange_card_style(tone, :value) %>">
                <%= remaining_time_text(deadline, at: requested_at) %>
              </span>
              <span class="tabular text-[11.5px] <%= exchange_card_style(tone, :note) %>">
                <%= l deadline, format: :schedule %>
              </span>
            <% else %>
              <%# マッチング実行待ち。待っているのは主催者の操作で、日時では動かない %>
              <span class="text-[11px] <%= exchange_card_style(tone, :label) %>">締切</span>
              <span class="text-[14px] leading-[1.4] <%= exchange_card_style(tone, :value) %>">なし</span>
              <span class="text-[11.5px] <%= exchange_card_style(tone, :note) %>">
                することはありません
              </span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
