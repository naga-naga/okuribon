<% content_for :title, "#{@exchange.name}の管理" %>

<div class="mx-auto w-full max-w-[900px] px-4 py-10 sm:px-6">
  <%# 戻り先は交換会トップだけにする。この画面へ来る入口がそこしかない %>
  <p class="text-[12px]"><%= link_to @exchange.name, exchange_path(@exchange) %></p>

  <%# 狭い画面では見出しとフェーズが縦に折り返る %>
  <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-2">
    <h1 class="text-[26px] font-bold leading-[1.45] text-ink">主催者管理</h1>

    <%# 松葉は成立と完了の担当。終わった交換会だけ色を変える %>
    <span class="rounded-[3px] bg-fill px-2 py-1 text-[12px] font-medium
                 <%= @exchange.phase(at: requested_at) == :published ? 'text-success' : 'text-ink-muted' %>">
      <%= @exchange.phase_name(at: requested_at) %>
    </span>
  </div>

  <div class="mt-8">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h2 class="text-[17px] font-bold text-ink">参加者</h2>
      <%# size ではなく length で数える。GROUP BY を持つリレーションの size は
          件数ではなくグループごとの件数のハッシュを返す。
          どのみち下の表で全件を回すので、読み込んでから数えて問い合わせも増やさない %>
      <span class="tabular text-[14px] font-medium text-ink-subtle">
        <%= @participations.length %>人・<%= @participations.sum(&:books_count) %>冊
      </span>
    </div>

    <%# 主催者に特権はない（docs/spec.md 8.）。書いておかないと、
        管理画面ならコードも見られるはずだと探させることになる %>
    <p class="mt-1.5 text-[12.5px] text-ink-subtle">ギフトコードは主催者にも見えません。</p>

    <%# 除外できるのは登録の締切まで（docs/spec.md 4.）。締切を過ぎたら列ごと畳む。
        押せる行が1つも無い列を残すと、見出しだけの空欄が並ぶ %>
    <% exclusion_open = @exchange.writable?(:participation, at: requested_at) %>

    <%# 狭い画面では表が横に溢れるので、この枠の中だけ横に送れるようにする %>
    <div class="mt-3 overflow-x-auto rounded-[4px] border border-line">
      <table class="w-full min-w-[520px] border-collapse text-left">
        <thead>
          <tr class="border-b border-line bg-surface-sunken">
            <th class="px-4 py-2.5 text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">名前</th>
            <th class="w-[90px] px-4 py-2.5 text-right text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">登録冊数</th>
            <th class="w-[140px] px-4 py-2.5 text-right text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">希望提出</th>
            <th class="w-[96px] px-4 py-2.5 text-right text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">参加日</th>
            <% if exclusion_open %>
              <th class="w-[84px] px-4 py-2.5 text-right text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">
                <%= t('management.participants.exclude') %>
              </th>
            <% end %>
          </tr>
        </thead>

        <tbody>
          <% @participations.each do |participation| %>
            <%# 1冊も登録していない人は受け取る本を持たない。行ごと沈めて、
                冊数の欄を見比べなくても目に留まるようにする %>
            <tr class="border-b border-line last:border-b-0
                       <%= participation.books_count.zero? ? 'bg-surface-sunken' : 'bg-paper' %>">
              <td class="px-4 py-3 text-[13.5px] text-ink">
                <%= participation.user.display_name %>
                <%# 主催者は必ず参加者を兼ねる（6.9）。自分の行が紛れるので印を付ける %>
                <% if @exchange.owner?(participation.user) %>
                  <span class="text-[11px] text-ink-subtle">主催・あなた</span>
                <% end %>
              </td>

              <td class="tabular px-4 py-3 text-right text-[13.5px]
                         <%= participation.books_count.zero? ? 'text-accent' : 'text-ink' %>">
                <%= participation.books_count %>冊
              </td>

              <%# 何を希望したかは出さない（docs/spec.md 8.）。出した冊数だけを出す。
                  未提出を朱にするのは、主催者が声を掛ける先がそこだけのため %>
              <td class="tabular px-4 py-3 text-right text-[13px]
                         <%= participation.wishes_count.zero? ? 'text-accent' : 'text-success' %>">
                <%= participation.wishes_count.zero? ? '未提出' : "提出済み #{participation.wishes_count}冊" %>
              </td>

              <td class="tabular px-4 py-3 text-right text-[12.5px] text-ink-subtle">
                <%= l participation.created_at.to_date, format: :compact %>
              </td>

              <% if exclusion_open %>
                <td class="px-4 py-3 text-right">
                  <%# 主催者は必ず参加者を兼ねるので自分の行には口を出さない（docs/spec.md 6.9）。
                      判定はサーバー側の Exchange#remove_participant! と同じ規則から引く。
                      ここで条件を手書きすると、押しても断られるボタンが残る %>
                  <% if @exchange.removable_participant?(participation.user, at: requested_at) %>
                    <%# 外すと本もギフトコードも消える。戻せないので確認を挟む %>
                    <%= button_to t('management.participants.exclude'),
                                  exchange_management_participant_path(@exchange, participation),
                                  method: :delete,
                                  form: { data: { turbo_confirm: t('management.participants.exclude_confirm',
                                                                   name: participation.user.display_name) } },
                                  class: 'cursor-pointer text-[12.5px] text-accent underline underline-offset-2 hover:opacity-70' %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# 0冊は締め出しではなく仕組みの結果（6.9）。書かないと、
        主催者が誤って登録を消したのかと疑う %>
    <p class="mt-3 text-[12px] leading-[1.8] text-ink-subtle">
      1冊も登録していない人は取得枠が0で、本を受け取りません。
    </p>

    <%# 除外の口はいつまで出るのか。締切後に列が消えたことを不具合と読ませない %>
    <p class="mt-1.5 text-[12px] leading-[1.8] text-ink-subtle">
      <%= t(exclusion_open ? 'management.participants.exclusion_open' : 'management.participants.exclusion_closed',
            at: l(@exchange.registration_ends_at, format: :schedule)) %>
    </p>
  </div>

  <%# 招待URLは人に渡すもの。渡した先がそのまま開けるよう、ホストごと出す %>
  <div class="mt-10" data-controller="clipboard">
    <div class="font-mono text-[10.5px] tracking-[0.12em] text-ink-subtle">招待URL</div>

    <%# 読み取り専用の入力欄に入れる。ただの文字として置くより選びやすく、
        クリップボードの API が使えない環境でも手でコピーできる %>
    <div class="mt-3 flex items-center gap-3 rounded-[5px] border border-line bg-paper px-4 py-3.5">
      <%= text_field_tag :invite_url, invitation_url(@exchange.invite_token),
                         readonly: true,
                         data: { clipboard_target: 'source' },
                         class: 'min-w-0 flex-1 bg-transparent font-mono text-[12.5px] text-ink focus:outline-none' %>

      <button type="button"
              data-action="clipboard#copy"
              data-clipboard-target="button"
              class="flex-none cursor-pointer rounded-[4px] border border-line-strong bg-paper px-3.5 py-2
                     text-[12.5px] font-medium text-ink hover:bg-paper-hover">
        コピー
      </button>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <%# 締切を過ぎるとこの URL からは参加できない。渡す前に分かるようにしておく %>
      <p class="text-[12px] leading-[1.8] text-ink-subtle">
        <%= t(@exchange.writable?(:participation, at: requested_at) ? 'management.invite_url.open' : 'management.invite_url.closed',
              at: l(@exchange.registration_ends_at, format: :schedule)) %>
      </p>

      <%# 押すと古いURLが開けなくなる。取り消せないので確認を挟む %>
      <%= button_to t('management.invite_url.reissue'),
                    exchange_management_invite_token_path(@exchange),
                    method: :patch,
                    form: { class: 'flex-none',
                            data: { turbo_confirm: t('management.invite_url.reissue_confirm') } },
                    class: 'cursor-pointer text-[12.5px] text-accent underline underline-offset-2 hover:opacity-70' %>
    </div>
  </div>

  <%# 日時の入力欄は交換会の編集画面に1つだけ置く（docs/spec.md 6.9）。
      ここは現在の日程を見せて、変更はそちらへ送る %>
  <div class="mt-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <div class="font-mono text-[10.5px] tracking-[0.12em] text-ink-subtle">
        <%= t('management.schedule.heading') %>
      </div>

      <%= link_to t('management.schedule.edit'), edit_exchange_path(@exchange),
                  class: 'text-[12.5px] text-accent underline underline-offset-2 hover:opacity-70' %>
    </div>

    <div class="mt-3 overflow-hidden rounded-[4px] border border-line">
      <% Exchange::PERIODS.each do |step| %>
        <% period = @exchange.period(step) %>
        <% state = @exchange.schedule_state(step, at: requested_at) %>

        <%# 終わった期間は沈める。いま動いているのがどれかを、日時を読み比べずに掴めるようにする %>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line
                    px-4 py-3 last:border-b-0 <%= state == :done ? 'bg-surface-sunken' : 'bg-paper' %>">
          <span class="text-[13px] text-ink"><%= t(step, scope: 'exchange.phases') %></span>

          <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <%# 終了時刻は期間に含まれない（docs/spec.md 4.）。範囲の右端は締切そのもの %>
            <span class="tabular text-[12.5px] text-ink-subtle">
              <%= l period.begin, format: :schedule %> — <%= l period.end, format: :schedule %>
            </span>

            <span class="text-[11.5px] <%= state == :current ? 'text-accent' : 'text-ink-subtle' %>">
              <%= t(state, scope: 'exchange.schedule.states') %>
            </span>
          </span>
        </div>
      <% end %>
    </div>

    <p class="mt-3 text-[12px] leading-[1.8] text-ink-subtle">
      <%= t(@exchange.phase(at: requested_at) == :published ? 'management.schedule.note_published' : 'management.schedule.note') %>
    </p>
  </div>

  <%# 参加者の除外（#39）、登録冊数の偏りの警告（#40）、マッチングの実行（#31）は、
      それぞれの画面が入るときにここへ足す %>
</div>
