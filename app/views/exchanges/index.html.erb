<% content_for :title, '交換会一覧' %>

<div class="mx-auto w-full max-w-[640px] px-4 py-10 sm:px-6">
  <h1 class="text-[26px] font-bold leading-[1.45] text-ink">交換会</h1>

  <% if @exchanges.empty? %>
    <%# 白紙で返すと、壊れているのか参加していないのか区別がつかない。
        参加の入口は招待URLしかないので、次にどうすればよいかまで書く %>
    <div class="mt-6 rounded-[5px] border border-line bg-paper px-5 py-6">
      <p class="text-[14.5px] font-medium text-ink">まだ参加している交換会はありません。</p>
      <p class="mt-2 text-[13px] leading-[1.85] text-ink-muted">
        主催者から届いた招待URLを開くと参加できます。
      </p>
    </div>
  <% else %>
    <ul class="mt-6 flex flex-col gap-3">
      <% @exchanges.each do |exchange| %>
        <%# 交換会トップ（#19）が入ったら、カードからそちらへ送る %>
        <li class="rounded-[5px] border border-line bg-paper px-5 py-5">
          <%# 狭い画面では交換会名とフェーズが縦に折り返る %>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <h2 class="text-[17px] font-bold leading-[1.5] text-ink"><%= exchange.name %></h2>

            <%# 松葉は成立と完了の担当。終わった交換会だけ色を変える %>
            <span class="rounded-[3px] bg-fill px-2 py-1 text-[12px] font-medium
                         <%= exchange.phase(at: requested_at) == :published ? 'text-success' : 'text-ink-muted' %>">
              <%= exchange.phase_name(at: requested_at) %>
            </span>
          </div>

          <%# 次の節目が無いフェーズでは、行ごと出さない %>
          <% if (deadline = exchange.next_deadline(at: requested_at)) %>
            <p class="mt-3 flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-2.5">
              <span class="text-[12px] text-ink-subtle">
                <%= exchange.next_deadline_name(at: requested_at) %>
              </span>
              <%# 朱は押すものと締切の担当 %>
              <span class="tabular text-[14.5px] font-medium text-accent">
                <%= l deadline, format: :schedule %>
              </span>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
