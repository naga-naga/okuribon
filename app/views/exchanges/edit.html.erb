<% content_for :title, "#{@exchange.name}の設定" %>

<div class="mx-auto w-full max-w-[640px] px-4 py-10 sm:px-6">
  <h1 class="text-[26px] font-bold leading-[1.45] text-ink"><%= @exchange.name %></h1>
  <p class="mt-2 text-[13.5px] leading-[1.9] text-ink-muted">
    現在は<%= @exchange.phase_name(at: requested_at) %>です。
  </p>

  <div class="mt-8">
    <%= render 'form', exchange: @exchange, submit_label: '変更を保存する' %>
  </div>
</div>
