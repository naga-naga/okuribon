<%# 409 と 403 で本文は変わるが、組み立ては同じにする。理由が違うだけで、
    断られた人がすることは「いまどうなっているかを読んで、交換会へ戻る」で共通。

    フェーズは message が言い切っている（現在は◯◯期間のため、◯◯はできません）ので、
    帯には出さない。同じ言葉を1画面に2度置くと、どちらが今の話か迷う %>
<% content_for :title, "この操作はできません — #{exchange.name}" %>

<% content_for :breadcrumb do %>
  <%= breadcrumb_ancestor exchange.name, exchange_path(exchange) %>
<% end %>

<div class="mx-auto w-full max-w-[560px] px-4 py-12 sm:px-6 sm:py-16">
  <div class="overflow-hidden rounded-[6px] border border-line bg-paper">
    <%# 書き込みの操作は交換会をまたいで同じ形をしている。名前を出さないと、
        どの交換会を操作していたのかが画面から読めない %>
    <div class="border-b border-line bg-surface-sunken px-6 py-3.5">
      <span class="text-[12.5px] font-bold text-ink"><%= exchange.name %></span>
    </div>

    <div class="flex flex-col gap-5 px-6 py-7">
      <span class="text-[10.5px] font-medium tracking-[0.14em] text-ink-subtle">
        <%= t('error.denied.code') %>
      </span>

      <h1 class="text-[22px] font-bold leading-[1.5] text-ink"><%= t('error.denied.heading') %></h1>

      <%# 現在のフェーズとできなかった操作が入っている。
          待てば書けるのか、そもそも通らないのかは、この一文が引き受ける %>
      <p class="text-[14px] leading-[2] text-ink"><%= message %></p>

      <%# 交換会の中の画面は交換会ページに集まっているので、出す導線は1つでよい %>
      <div class="pt-1">
        <%= link_to t('error.denied.back'), exchange_path(exchange),
                    class: 'inline-block rounded-[5px] bg-accent px-5 py-3 text-[14px] ' \
                           'font-medium text-paper no-underline hover:bg-accent-hover' %>
      </div>
    </div>
  </div>
</div>
