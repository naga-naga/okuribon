<% content_for :title, "#{@exchange.name}の本" %>

<%# 登録・希望の可否は1回だけ引く。カードごとに引き直すと、
    描いている途中で締切をまたいだときに1つの画面の中で出し分けが食い違う %>
<% registering = @exchange.writable?(:book, at: requested_at) %>
<% wishing = @exchange.writable?(:wish, at: requested_at) %>

<%# 自分の本は取得枠の数でもあり、絞り込みの行き先でもある。
    読み込み済みの一覧から選ぶので、カードごとに COUNT が飛ばない %>
<% my_books = @books.select { it.participation_id == @participation.id } %>

<%# 希望リストは狭い画面では下部に固定されるので、その高さぶん一覧の下を空ける %>
<div class="mx-auto w-full px-4 pt-10 sm:px-6
            <%= wishing ? 'max-w-[1180px] pb-44 lg:pb-10' : 'max-w-[1080px] pb-10' %>">
  <%# 戻り先は交換会トップだけにする。この画面へ来る入口がそこしかない %>
  <p class="text-[12px]"><%= link_to @exchange.name, exchange_path(@exchange) %></p>

  <%# 見出しの行の右端に登録の口を置く。何冊でも登録できるので、
      登録を終えて戻ってきたところがそのまま次の入口になる。
      一覧の下に置くと、冊数が増えるほど次の1冊が遠くなる。
      狭い画面では見出しとボタンが縦に折り返る %>
  <div class="mt-4 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
    <div>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
        <h1 class="text-[26px] font-bold leading-[1.45] text-ink">みんなの本</h1>
        <span class="tabular text-[15px] font-medium text-ink-subtle">
          <%= @books.size %>冊 ／ <%= @participant_count %>人
        </span>
      </div>

      <%# 数週間かかるツールなので、開いた日になにをすればよいかをここで言う %>
      <p class="mt-1.5 text-[13px] leading-[1.85] text-ink-muted">
        <%= book_index_guide(@exchange, at: requested_at) %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%# 1冊も無いうちは出さない。行き先が両方とも空の絞り込みになる %>
      <% if @books.any? %>
        <div class="flex overflow-hidden rounded-[5px] border border-line-strong">
          <%= link_to 'すべて', exchange_books_path(@exchange),
                      class: book_filter_segment_class(!@mine_only) %>
          <%= link_to "自分の本 #{my_books.size}", exchange_books_path(@exchange, filter: :mine),
                      class: "border-l border-line-strong #{book_filter_segment_class(@mine_only)}" %>
        </div>
      <% end %>

      <% if registering %>
        <%= link_to '本を登録する', new_exchange_book_path(@exchange),
                    class: 'rounded-[5px] bg-accent px-5 py-2.5 text-[14px] font-medium ' \
                           'text-paper no-underline hover:bg-accent-hover' %>
      <% end %>
    </div>
  </div>

  <%# 希望を選ぶ間だけ、一覧の脇に希望リストが並ぶ。それ以外のフェーズでは
      並べ替える対象が無いので、一覧が幅いっぱいを使う %>
  <div class="<%= 'lg:flex lg:items-start lg:gap-6' if wishing %>">
    <div class="min-w-0 flex-1">
      <%= render 'books/grid', exchange: @exchange, books: @mine_only ? my_books : @books,
                               participation: @participation, wishes: @wishes,
                               registering:, wishing:, slots: my_books.size, mine_only: @mine_only %>
    </div>

    <% if wishing %>
      <%= render 'wishes/sheet', exchange: @exchange, wishes: @wishes %>
    <% end %>
  </div>
</div>
