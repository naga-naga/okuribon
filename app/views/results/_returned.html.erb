<%# 返却は受け取りの下に置き、順序で軽重を示す。沈めた面にして、
    受け取った本の松葉の縁と扱いを分ける %>
<section class="rounded-[6px] border border-line-strong bg-surface-sunken p-5 sm:p-7">
  <p class="font-mono text-[10.5px] tracking-[0.12em] text-ink-subtle"><%= t('result.returned.eyebrow') %></p>

  <h2 class="mt-1.5 text-[20px] font-bold leading-[1.5] text-ink">
    <%= returned.one? ? t('result.returned.heading_one', title: returned.first.book.title)
                      : t('result.returned.heading_many', count: returned.size) %>
  </h2>

  <%# 事実だけを書くと、選ばれなかったことを本の評価として読んでしまう %>
  <p class="mt-3 max-w-[560px] text-[13.5px] leading-[1.95] text-ink"><%= t('result.returned.body') %></p>

  <%# 何が残るのかを並べる。返却を「失った」と読ませないための3行 %>
  <ul class="mt-4 flex flex-col gap-1.5 border-t border-line pt-4">
    <% t('result.returned.notes').each do |note| %>
      <li class="text-[12.5px] leading-[1.9] text-ink-muted">・<%= note %></li>
    <% end %>
  </ul>

  <%# 誰にも渡らなかったコードの取り出し口は、この画面以外に無い。
      受け取った本と同じ形で開けるようにする %>
  <div class="mt-5 flex flex-col gap-4">
    <% returned.each do |assignment| %>
      <div class="flex flex-col gap-2">
        <%# 1冊だけのときは見出しが題名を言っているので、繰り返さない %>
        <% unless returned.one? %>
          <p class="text-[14px] font-bold text-ink"><%= assignment.book.title %></p>
        <% end %>

        <%= render 'results/gift_code',
                   code: assignment.book.gift_code_for(current_user, at: requested_at),
                   note: t('result.gift_code.note_returned') %>
      </div>
    <% end %>
  </div>
</section>
