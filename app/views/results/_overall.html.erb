<%# 全体の成立結果。誰が誰の本を受け取ったかは参加者全員に見える（docs/spec.md 8.）。
    ギフトコードは並べない。一覧系のビューには絶対に含めない（CLAUDE.md） %>
<% returned_count = result_books.count { it.assignment&.returned? } %>

<section class="border-t border-line pt-7">
  <div class="flex flex-wrap items-end justify-between gap-x-5 gap-y-1.5">
    <h2 class="text-[19px] font-bold text-ink"><%= t('result.overall.heading') %></h2>

    <p class="tabular font-mono text-[11px] tracking-[0.12em] text-ink-subtle">
      <%= t('result.overall.counts', matched: result_books.size - returned_count, returned: returned_count) %>
    </p>
  </div>

  <p class="mt-1.5 max-w-[560px] text-[12.5px] leading-[1.9] text-ink-muted"><%= t('result.overall.note') %></p>

  <%# 狭い画面では3列が溢れるので、この枠の中だけ横に送れるようにする %>
  <div class="mt-3.5 overflow-x-auto rounded-[4px] border border-line">
    <table class="w-full min-w-[440px] border-collapse text-left">
      <thead>
        <tr class="border-b border-line bg-surface-sunken">
          <th class="px-4 py-2.5 text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">
            <%= t('result.overall.columns.book') %>
          </th>
          <th class="w-[136px] px-4 py-2.5 text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">
            <%= t('result.overall.columns.registrant') %>
          </th>
          <th class="w-[136px] px-4 py-2.5 text-[10.5px] font-normal tracking-[0.1em] text-ink-subtle">
            <%= t('result.overall.columns.recipient') %>
          </th>
        </tr>
      </thead>

      <tbody>
        <% result_books.each do |book| %>
          <%# 返却は渡らなかった本。行ごと沈めて、受け取った人の欄を読み比べなくても目に留まるようにする %>
          <% returned = book.assignment&.returned? %>
          <tr class="border-b border-line last:border-b-0 <%= returned ? 'bg-surface-sunken' : 'bg-paper' %>">
            <td class="px-4 py-3 text-[13.5px] <%= returned ? 'text-ink-muted' : 'text-ink' %>">
              <%= book.title %>
            </td>

            <td class="px-4 py-3 text-[13px] text-ink-muted">
              <%= result_person_name(book.registrant, viewer: current_user) %>
            </td>

            <td class="px-4 py-3 text-[13px] <%= returned ? 'text-ink-subtle' : 'text-success' %>">
              <%= result_recipient_name(book, viewer: current_user) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# 抽選順が入るのはマッチングを実行した交換会だけ。畳んでおく %>
  <% if draft_order.any? %>
    <details class="mt-3.5 rounded-[4px] border border-line bg-paper px-4 py-3">
      <summary class="cursor-pointer text-[12.5px] text-accent underline underline-offset-2">
        <%= t('result.draft_order.summary') %>
      </summary>

      <%# 並びだけを出すと、早い人が得をしたように読める。
          巡ごとに順序が逆になることを添える（docs/spec.md 3.） %>
      <p class="mt-3 max-w-[560px] text-[12.5px] leading-[1.9] text-ink-muted">
        <%= t('result.draft_order.note') %>
      </p>

      <ol class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 border-t border-line pt-3">
        <% draft_order.each_with_index do |participation, index| %>
          <li class="text-[13px] text-ink">
            <span class="tabular font-mono text-[11px] text-ink-subtle"><%= index + 1 %></span>
            <%= result_person_name(participation.user, viewer: current_user) %>
          </li>
        <% end %>
      </ol>
    </details>
  <% end %>
</section>
