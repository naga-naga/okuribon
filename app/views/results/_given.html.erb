<%# 自分が出した本の行き先。全体の一覧にも同じ本が並ぶが、受け取ったものと
    同じくらい気になるので、十数行の表から探させずに先へ抜き出す。
    何番目の希望で渡ったかは書かない %>
<section class="flex flex-col gap-3">
  <p class="font-mono text-[10.5px] tracking-[0.12em] text-ink-subtle"><%= t('result.given.eyebrow') %></p>

  <ul class="overflow-hidden rounded-[4px] border border-line">
    <% given.each do |book| %>
      <% assignment = book.assignment %>
      <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line bg-paper px-4 py-3.5 last:border-b-0">
        <span class="text-[14px] font-bold text-ink"><%= book.title %></span>

        <% if assignment && !assignment.returned? %>
          <span class="text-[13px] text-success">
            <%= t('result.given.to', name: assignment.participation.user.display_name) %>
          </span>
        <% else %>
          <%# 返却の事情は上の「あなたが出した本」が書いている。ここは行き先だけを言う %>
          <span class="text-[13px] text-ink-subtle"><%= t('result.given.returned') %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
